# Copy this file to .env on the deployment host and replace every secret.
# Do not commit the real .env file.

POSTGRES_DB=rendezvous
POSTGRES_USER=rendezvous
POSTGRES_PASSWORD=change-this-postgres-password

JWT_ISSUER=Rendezvous.Api
JWT_AUDIENCE=Rendezvous.Web
JWT_SIGNING_KEY=change-this-to-a-long-random-production-signing-key

# Disabled is suitable for image boot smoke tests only. Real signup confirmation
# requires EMAIL_PROVIDER=Resend, a verified EMAIL_FROM_ADDRESS, and RESEND_API_KEY.
EMAIL_PROVIDER=Disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Rendezvous
RESEND_API_KEY=

STYLE_PREVIEW_API_KEY=change-this-google-style-preview-api-key
STYLE_PREVIEW_MODEL=gemini-2.5-flash-image

RENDEZVOUS_API_BASE_URL=http://api:8080
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
